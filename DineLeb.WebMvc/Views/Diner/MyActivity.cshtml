@model DineLeb.WebMvc.Models.DinerDashboardViewModel
@{
    ViewData["Title"] = "My Diner Activity & Disputes";
    var restaurantNames = ViewBag.RestaurantNames as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="container my-4">
    <!-- Header -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill mb-2">
                    <i class="bi bi-person-fill me-1"></i>Verified Diner Portal
                </span>
                <h2 class="fw-bold mb-1">My Activity & Disputes</h2>
                <p class="text-muted small mb-0">Track all your private restaurant tickets and public reviews in one place.</p>
            </div>
            <div class="d-flex gap-3">
                <div class="text-center px-3 py-2 bg-light rounded-3 border">
                    <span class="d-block text-muted small">My Disputes</span>
                    <strong class="text-danger fs-5">@Model.Tickets.Count</strong>
                </div>
                <div class="text-center px-3 py-2 bg-light rounded-3 border">
                    <span class="d-block text-muted small">My Reviews</span>
                    <strong class="text-warning fs-5">@Model.Reviews.Count</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Tickets Section -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-shield-lock-fill text-danger me-2"></i>My Private Dispute Tickets
            </h5>
            <small class="text-muted">Confidential complaints sent to management</small>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-muted text-uppercase">
                        <th>Restaurant</th>
                        <th>Issue / Details</th>
                        <th>Category</th>
                        <th>Date Sent</th>
                        <th>Status</th>
                        <th>Management Response</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Tickets.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted small">You haven't submitted any private dispute tickets yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in Model.Tickets)
                        {
                            var rName = restaurantNames.ContainsKey(ticket.RestaurantId) ? restaurantNames[ticket.RestaurantId] : "Restaurant #" + ticket.RestaurantId;
                            <tr>
                                <td>
                                    <strong class="text-dark">@rName</strong>
                                    <a asp-controller="Restaurants" asp-action="Details" asp-route-id="@ticket.RestaurantId" class="d-block small text-muted text-decoration-none">
                                        View Profile <i class="bi bi-arrow-right-short"></i>
                                    </a>
                                </td>
                                <td>
                                    <strong class="d-block text-dark">@ticket.Title</strong>
                                    <small class="text-muted d-block" style="max-width: 320px;">@ticket.Description</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@ticket.Category</span></td>
                                <td><small class="text-muted">@ticket.CreatedAt.ToString("MMM dd, yyyy")</small></td>
                                <td>
                                    @if (ticket.Status == DineLeb.Domain.Enums.TicketStatus.Resolved)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1 rounded-pill">
                                            <i class="bi bi-check-circle me-1"></i>Resolved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1 rounded-pill">
                                            <i class="bi bi-hourglass-split me-1"></i>Pending
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(ticket.OwnerResolutionNotes))
                                    {
                                        <div class="small bg-light p-2 rounded-3 border-start border-3 border-success">
                                            <strong class="text-success d-block"><i class="bi bi-reply-fill me-1"></i>Management Resolution:</strong>
                                            <span class="text-dark">@ticket.OwnerResolutionNotes</span>
                                            @if (ticket.ResolvedAt.HasValue)
                                            {
                                                <small class="d-block text-muted mt-1" style="font-size: 0.7rem;">@ticket.ResolvedAt.Value.ToString("MMM dd, yyyy - hh:mm tt")</small>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="small text-muted fst-italic">Awaiting restaurant response...</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Reviews Section -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-chat-quote-fill text-warning me-2"></i>My Public Reviews
            </h5>
        </div>
        <div class="card-body p-4">
            @if (!Model.Reviews.Any())
            {
                <p class="text-muted small text-center mb-0 py-3">You haven't published any reviews yet.</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var rev in Model.Reviews)
                    {
                        var rName = restaurantNames.ContainsKey(rev.RestaurantId) ? restaurantNames[rev.RestaurantId] : "Restaurant #" + rev.RestaurantId;
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-4 border h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="text-dark">@rName</strong>
                                    <span class="text-warning small">
                                        @for (int i = 0; i < rev.Rating; i++)
                                        {
                                            <span>★</span>
                                        }
                                    </span>
                                </div>
                                <p class="text-muted small mb-2">@rev.Comment</p>
                                <small class="text-muted opacity-75" style="font-size: 0.75rem;">@rev.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>