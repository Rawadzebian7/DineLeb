@model DineLeb.WebMvc.Models.RestaurantListViewModel
@{
    ViewData["Title"] = "Lebanese Restaurant Trust Platform";
}

<!-- Hero Section -->
<div class="p-5 mb-5 rounded-4 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <span class="badge bg-danger px-3 py-2 rounded-pill fw-semibold mb-3">
                <i class="bi bi-shield-fill-check me-1"></i> Lebanon's Verified Hospitality Index
            </span>
            <h1 class="display-5 fw-bold mb-3">Elevating Lebanese Dining Through Accountability.</h1>
            <p class="lead text-light opacity-75 mb-4">
                Zero fake accounts. Guaranteed private conflict resolution with verified restaurant management across Beirut and all Lebanese districts.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Account" asp-action="Register" class="btn btn-danger btn-lg px-4 rounded-pill fw-semibold">
                    <i class="bi bi-person-plus me-1"></i> Join as Diner
                </a>
                <a asp-controller="Restaurants" asp-action="Register" class="btn btn-outline-light btn-lg px-4 rounded-pill fw-semibold">
                    <i class="bi bi-shop me-1"></i> Register Restaurant Partner
                </a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block text-center">
            <div class="p-4 bg-white bg-opacity-10 rounded-4 border border-white border-opacity-10 text-start">
                <h6 class="text-uppercase fw-bold text-danger small mb-3">How DineLeb Works</h6>
                <div class="d-flex gap-3 mb-3">
                    <div class="fs-4 text-warning"><i class="bi bi-person-badge"></i></div>
                    <div>
                        <strong class="d-block text-white">1. Authenticated Diners</strong>
                        <small class="text-light opacity-75">Every review and private ticket requires a verified identity.</small>
                    </div>
                </div>
                <div class="d-flex gap-3 mb-3">
                    <div class="fs-4 text-info"><i class="bi bi-file-earmark-check"></i></div>
                    <div>
                        <strong class="d-block text-white">2. Gated Commercial Entities</strong>
                        <small class="text-light opacity-75">Authenticated via commercial register before publication.</small>
                    </div>
                </div>
                <div class="d-flex gap-3">
                    <div class="fs-4 text-success"><i class="bi bi-chat-left-dots"></i></div>
                    <div>
                        <strong class="d-block text-white">3. Direct Dispute Mediation</strong>
                        <small class="text-light opacity-75">Resolve complaints confidentially with management.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-5">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" class="form-control border-start-0" placeholder="Search restaurant name or cuisine..." />
            </div>
        </div>
        <div class="col-md-4">
            <input type="text" name="city" class="form-control" placeholder="City (e.g. Beirut, Byblos, Amchit)" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100 fw-semibold">Filter</button>
        </div>
    </form>
</div>

<!-- Verified Directory -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Active Verified Restaurants</h3>
        <p class="text-muted small mb-0">Browse approved Lebanese venues maintaining public accountability.</p>
    </div>
    <a asp-action="Leaderboard" class="btn btn-outline-secondary btn-sm rounded-pill fw-semibold">
        <i class="bi bi-trophy text-warning me-1"></i> View Trust Rankings
    </a>
</div>

<div class="row g-4">
    @if (Model.Restaurants == null || !Model.Restaurants.Any())
    {
        <div class="col-12 text-center py-5">
            <p class="text-muted">No verified restaurants available currently.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model.Restaurants)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-light text-dark border rounded-pill px-3 py-1 small">
                                <i class="bi bi-geo-alt text-danger me-1"></i>@item.City
                            </span>
                            @if (item.IsVerified)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                    <i class="bi bi-check-circle-fill me-1"></i>Verified
                                </span>
                            }
                        </div>

                        <h4 class="card-title fw-bold text-dark mt-2 mb-1">@item.Name</h4>
                        <p class="card-text text-muted small flex-grow-1">@item.Description</p>

                        <div class="p-3 bg-light rounded-3 my-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small text-muted">Diner Rating:</span>
                                <span class="fw-bold text-warning">
                                    <i class="bi bi-star-fill"></i> @item.AverageRating.ToString("0.0")
                                    <span class="text-muted small fw-normal">(@item.ReviewCount reviews)</span>
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small text-muted">Resolved Tickets:</span>
                                <span class="fw-bold text-success">
                                    <i class="bi bi-check2-all"></i> @item.ResolvedTicketsCount / @item.TotalTicketsCount
                                </span>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-dark btn-sm flex-grow-1 rounded-pill fw-semibold">
                                View Profile
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>