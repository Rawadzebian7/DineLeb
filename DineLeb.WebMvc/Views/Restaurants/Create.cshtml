@model DineLeb.WebMvc.Models.CreateRestaurantInputModel
@{
    ViewData["Title"] = "Register Restaurant";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="mb-4">
                    <a asp-action="Index" class="btn btn-sm btn-light text-muted mb-3 border rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Back to Directory
                    </a>
                    <h2 class="fw-bold text-dark">Register Restaurant</h2>
                    <p class="text-muted">Add your restaurant profile to start receiving reviews and resolving direct customer tickets.</p>
                </div>

                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Restaurant Name</label>
                        <input asp-for="Name" class="form-control form-control-lg rounded-3 fs-6" placeholder="e.g. Al Sultan Brahim" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">City</label>
                            <select asp-for="City" class="form-select rounded-3">
                                <option value="Beirut">Beirut</option>
                                <option value="Jounieh">Jounieh</option>
                                <option value="Byblos">Byblos (Jbeil)</option>
                                <option value="Batroun">Batroun</option>
                                <option value="Tripoli">Tripoli</option>
                                <option value="Saida">Saida</option>
                                <option value="Zahle">Zahle</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="+961 1 123456" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Street / Area Address</label>
                        <input asp-for="Address" class="form-control rounded-3" placeholder="e.g. Downtown, Weygand Street" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Description & Cuisine Type</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="3"
                                  placeholder="Authentic Lebanese mezzeh, fresh seafood, and terrace dining..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold rounded-3 py-2">
                        <i class="bi bi-building-add me-2"></i> Publish Restaurant
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>