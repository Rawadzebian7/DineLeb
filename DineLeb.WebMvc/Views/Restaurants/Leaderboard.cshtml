@model IEnumerable<DineLeb.Domain.Entities.Restaurant>
@{
    ViewData["Title"] = "Lebanese Restaurant Trust Leaderboard";
    int rank = 1;
}

<div class="text-center mb-5 mt-3">
    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill mb-2 fw-semibold">
        <i class="bi bi-award-fill me-1"></i> Certified Accountability Index
    </span>
    <h1 class="fw-bold display-6">Lebanese Trust Leaderboard</h1>
    <p class="text-muted col-lg-7 mx-auto">
        Rankings determined by speed and transparency in resolving private customer disputes, verified ratings, and commercial compliance.
    </p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th class="ps-4">Rank</th>
                            <th>Restaurant</th>
                            <th>Location</th>
                            <th>Rating</th>
                            <th>Resolution Rate</th>
                            <th class="text-end pe-4">Profile</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">No ranked establishments available yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var res in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        @if (rank == 1)
                                        {
                                            <span class="badge bg-warning text-dark rounded-circle p-2 fs-6">🥇</span>
                                        }
                                        else if (rank == 2)
                                        {
                                            <span class="badge bg-secondary text-white rounded-circle p-2 fs-6">🥈</span>
                                        }
                                        else if (rank == 3)
                                        {
                                            <span class="badge bg-danger-subtle text-danger rounded-circle p-2 fs-6">🥉</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-muted ps-2">#@rank</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <strong>@res.Name</strong>
                                            @if (res.IsVerified)
                                            {
                                                <i class="bi bi-patch-check-fill text-success" title="Verified Commercial Entity"></i>
                                            }
                                        </div>
                                        <small class="text-muted d-block">Register: @res.CommercialRegisterNumber</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@res.City</span>
                                    </td>
                                    <td>
                                        <span class="text-warning fw-bold">
                                            <i class="bi bi-star-fill"></i> @res.AverageRating.ToString("0.0")
                                        </span>
                                        <small class="text-muted">(@res.ReviewCount)</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill fw-semibold">
                                            <i class="bi bi-check2-all me-1"></i>@res.ResolvedTicketsCount / @res.TotalTicketsCount Solved
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Details" asp-route-id="@res.Id" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                                rank++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>