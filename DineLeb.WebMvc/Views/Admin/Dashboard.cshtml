@model List<DineLeb.Domain.Entities.Restaurant>
@{
    ViewData["Title"] = "Super Admin Approvals";
    var pendingRestaurants = Model.Where(r => !r.IsActive).ToList();
    var activeRestaurants = Model.Where(r => r.IsActive).ToList();
}

<div class="container my-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill mb-2">
                    <i class="bi bi-shield-lock-fill me-1"></i>Super Admin Control Panel
                </span>
                <h2 class="fw-bold mb-0">Restaurant Verification & Moderation</h2>
            </div>
            <div class="text-end">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill me-2">@pendingRestaurants.Count Pending</span>
                <span class="badge bg-success text-white px-3 py-2 rounded-pill">@activeRestaurants.Count Active</span>
            </div>
        </div>
    </div>

    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["AdminMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Pending Approvals Table -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0 text-warning-emphasis">
                <i class="bi bi-hourglass-split me-2"></i>Pending Restaurant Approvals (@pendingRestaurants.Count)
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-muted text-uppercase">
                        <th>Restaurant</th>
                        <th>City / Address</th>
                        <th>Commercial Register No.</th>
                        <th>Contact</th>
                        <th>Submitted</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!pendingRestaurants.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted small">No pending restaurant applications.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in pendingRestaurants)
                        {
                            <tr>
                                <td>
                                    <strong class="d-block text-dark">@item.Name</strong>
                                    <small class="text-muted">@item.Description</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.City</span>
                                    <small class="d-block text-muted mt-1">@item.Address</small>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.CommercialRegisterNumber))
                                    {
                                        <span class="badge bg-dark text-white">Pending Upload</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border fw-bold">@item.CommercialRegisterNumber</span>
                                    }
                                </td>
                                <td><small class="text-muted"><i class="bi bi-telephone me-1"></i>@item.PhoneNumber</small></td>
                                <td><small class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</small></td>
                                <td class="text-end pe-3">
                                    <div class="d-inline-flex gap-2">
                                        <form asp-action="ApproveRestaurant" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 fw-semibold">
                                                <i class="bi bi-check-circle me-1"></i>Approve & Activate
                                            </button>
                                        </form>
                                        <form asp-action="RejectRestaurant" method="post" class="d-inline" onsubmit="return confirm('Reject and delete this application?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                                <i class="bi bi-trash3 me-1"></i>Reject
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Active & Approved Restaurants Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0 text-success">
                <i class="bi bi-check-circle-fill me-2"></i>Active & Approved Restaurants (@activeRestaurants.Count)
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-muted text-uppercase">
                        <th>Restaurant</th>
                        <th>City</th>
                        <th>Rating</th>
                        <th>Tickets Resolved</th>
                        <th>Commercial Register</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!activeRestaurants.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted small">No active restaurants yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in activeRestaurants)
                        {
                            <tr>
                                <td><strong class="text-dark">@item.Name</strong></td>
                                <td>@item.City</td>
                                <td><span class="text-warning fw-bold"><i class="bi bi-star-fill me-1"></i>@item.AverageRating.ToString("0.0")</span></td>
                                <td>
                                    <span class="badge bg-success-subtle text-success rounded-pill px-2">
                                        @item.ResolvedTicketsCount / @item.TotalTicketsCount
                                    </span>
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.CommercialRegisterNumber</span></td>
                                <td class="text-end pe-3">
                                    <form asp-action="DeleteRestaurant" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently remove this active restaurant?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                            <i class="bi bi-trash3 me-1"></i>Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>